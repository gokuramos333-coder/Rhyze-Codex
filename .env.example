# PostgreSQL database used by Prisma.
DATABASE_URL="postgresql://rhyze:rhyze@localhost:5432/rhyze_fitness?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public application URL used in account links.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Optional seed owner. Never put a real password in this file.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD=""

# Stripe payments, saved payment methods, referral discounts, and transfer fees.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional Dashboard configuration ID for the branded Customer Portal.
STRIPE_PORTAL_CONFIGURATION_ID=""

# Background job authorization and transactional email delivery.
JOB_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="Rhyze Fitness <melissa@rhyzefit.com>"
EMAIL_REPLY_TO="melissa@rhyzefit.com"
# Keep false on staging until the queued-email backlog has been reviewed.
EMAIL_DELIVERY_ENABLED="false"
EMAIL_DELIVERY_RESUME_AT=""
# Keep RESEND_API_KEY limited to sending. Use a separate full-access key only
# for retrieving inbound bodies and attachments in the verified webhook route.
RESEND_RECEIVING_API_KEY=""
RESEND_WEBHOOK_SECRET=""
# Development can use the Resend-managed receiving domain shown in its dashboard.
# Production should use a dedicated receiving subdomain so existing business email MX records stay untouched.
RESEND_INBOUND_DOMAIN=""
CONTACT_TO_EMAIL="melissa@rhyzefit.com"
CONTACT_FROM_EMAIL="Rhyze Fitness <melissa@rhyzefit.com>"

# Durable uploads. Local is development-only. On Netlify use "netlify".
# Other production hosts can use "s3" with AWS S3, Cloudflare R2, or compatible storage.
STORAGE_DRIVER="local"
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_FORCE_PATH_STYLE="false"
