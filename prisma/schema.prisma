generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  INSTRUCTOR
  MEMBER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum ClassIntensity {
  LOW
  MODERATE
  HIGH
  ALL_LEVELS
}

enum OccurrenceStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  LATE_CANCELLED
  ATTENDED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  PROMOTED
  LEFT
  EXPIRED
}

enum AttendanceStatus {
  CHECKED_IN
  ATTENDED
  NO_SHOW
  LATE_CANCELLED
}

enum CreditEntryType {
  GRANT
  RESERVE
  CONSUME
  RELEASE
  RESTORE
  EXPIRE
  ADJUSTMENT
}

enum ProductKind {
  INTRO_TRIAL
  MONTHLY_UNLIMITED
  LIMITED_MEMBERSHIP
  CLASS_PACK
  DROP_IN
  VIP
}

enum BillingInterval {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CommerceOrderKind {
  MERCHANDISE
  EVENT
}

enum CommerceOrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  FULFILLMENT_REVIEW
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum PaymentRecordKind {
  PRODUCT_PURCHASE
  MEMBERSHIP_RENEWAL
  MERCHANDISE
  EVENT
  TRANSFER_FEE
  LATE_CANCELLATION_FEE
  NO_SHOW_FEE
}

enum PaymentRecordStatus {
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum MembershipStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum MembershipChangeRequestType {
  CHANGE
  CANCEL
}

enum MembershipChangeRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum EmailStatus {
  QUEUED
  PROCESSING
  SENT
  RECEIVED
  FAILED
  CANCELLED
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum InstructorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CredentialType {
  INSURANCE
  CPR
}

enum CredentialStatus {
  UNDER_REVIEW
  VALID
  REJECTED
}

enum CommissionStatus {
  PENDING
  EARNED
  REVERSED
  PAID
}

enum TransferStatus {
  COMPLETED
  PAYMENT_FAILED
  BLOCKED
}

model User {
  id                   String     @id @default(cuid())
  name                 String?
  email                String     @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  credentialsUpdatedAt DateTime?
  role                 Role       @default(MEMBER)
  status               UserStatus @default(ACTIVE)
  lastLoginAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  stripeCustomerId     String?    @unique

  accounts                 Account[]
  sessions                 Session[]
  authenticators           Authenticator[]
  memberProfile            MemberProfile?
  instructorProfile        InstructorProfile?
  notificationPreference   NotificationPreference?
  passwordResetTokens      PasswordResetToken[]
  accountClaimTokens       AccountClaimToken[]
  waiverAcceptances        WaiverAcceptance[]
  auditLogs                AuditLog[]                  @relation("AuditActor")
  classOccurrences         ClassOccurrence[]           @relation("OccurrenceInstructor")
  classSeries              ClassSeries[]               @relation("SeriesInstructor")
  bookings                 Booking[]
  waitlistEntries          WaitlistEntry[]
  attendanceRecords        AttendanceRecord[]          @relation("AttendanceMember")
  attendanceMarked         AttendanceRecord[]          @relation("AttendanceMarker")
  creditAccounts           CreditAccount[]
  purchases                Purchase[]
  memberships              Membership[]
  membershipChangeRequests MembershipChangeRequest[]   @relation("MembershipChangeMember")
  membershipChangeReviews  MembershipChangeRequest[]   @relation("MembershipChangeReviewer")
  membershipFreezesCreated MembershipFreeze[]          @relation("MembershipFreezeCreator")
  commerceOrders           CommerceOrder[]
  paymentRecords           PaymentRecord[]
  emailMessages            EmailMessage[]
  campaignsCreated         EmailCampaign[]             @relation("CampaignCreator")
  instructorApplication    InstructorApplication?      @relation("InstructorApplicant")
  instructorReviews        InstructorApplication[]     @relation("InstructorReviewer")
  referralCodes            ReferralCode[]              @relation("ReferralInstructor")
  instructorCredentials    InstructorCredential[]      @relation("CredentialInstructor")
  credentialReviews        InstructorCredential[]      @relation("CredentialReviewer")
  referralAttribution      ReferralAttribution?        @relation("ReferredCustomer")
  instructorCommissions    ReferralCommission[]        @relation("CommissionInstructor")
  referralCommission       ReferralCommission?         @relation("CommissionCustomer")
  inAppNotifications       InAppNotification[]
  memberConversation       MemberConversation?         @relation("ConversationMember")
  conversationMessages     MemberConversationMessage[] @relation("ConversationSender")
  classMessagesAuthored    ClassMessage[]              @relation("ClassMessageInstructor")
  sombleClientProfile      SombleClientProfile?
  sombleTransactions       SombleTransaction[]

  @@index([role, status])
  @@index([createdAt])
}

model ClassCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates ClassTemplate[]

  @@index([isActive, name])
}

model ClassTemplate {
  id                 String         @id @default(cuid())
  categoryId         String
  name               String
  slug               String         @unique
  description        String
  imageUrl           String?
  durationMinutes    Int
  intensity          ClassIntensity @default(ALL_LEVELS)
  defaultCapacity    Int
  dropInPriceCents   Int?
  tags               String[]
  equipment          String[]
  cancellationPolicy String?
  isActive           Boolean        @default(true)
  isEvent            Boolean        @default(false)
  archivedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  category    ClassCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  series      ClassSeries[]
  occurrences ClassOccurrence[]

  @@index([categoryId, isActive])
  @@index([archivedAt])
}

model ClassGalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  altText   String
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  timezone  String   @default("America/New_York")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms Room[]
}

model Room {
  id         String   @id @default(cuid())
  locationId String
  name       String
  capacity   Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location    Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  series      ClassSeries[]
  occurrences ClassOccurrence[]

  @@unique([locationId, name])
}

model ClassSeries {
  id             String    @id @default(cuid())
  templateId     String
  instructorId   String?
  roomId         String?
  timezone       String    @default("America/New_York")
  recurrenceRule String
  startsAt       DateTime
  endsAt         DateTime?
  capacity       Int?
  priceCents     Int?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  template    ClassTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  instructor  User?             @relation("SeriesInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  room        Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  occurrences ClassOccurrence[]

  @@index([templateId, isActive])
  @@index([instructorId, startsAt])
}

model ClassOccurrence {
  id                    String           @id @default(cuid())
  templateId            String
  seriesId              String?
  instructorId          String?
  roomId                String?
  startAt               DateTime
  endAt                 DateTime
  timezone              String           @default("America/New_York")
  capacity              Int
  priceCents            Int?
  status                OccurrenceStatus @default(SCHEDULED)
  publicNotes           String?
  internalNotes         String?
  titleOverride         String?
  substituteInstructorName String?
  isSubstitute          Boolean          @default(false)
  cancellationReason    String?
  historicalSignupCount Int              @default(0)
  instructorPayMethod   String           @default("STANDARD_CLASS_RATE")
  instructorPayCents    Int?
  instructorPayNote     String?
  cancelledAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  template          ClassTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  series            ClassSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  instructor        User?              @relation("OccurrenceInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  room              Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bookings          Booking[]
  waitlistEntries   WaitlistEntry[]
  attendanceRecords AttendanceRecord[]
  classMessages     ClassMessage[]
  commerceOrders    CommerceOrder[]

  @@index([startAt, status])
  @@index([instructorId, startAt, endAt])
  @@index([roomId, startAt, endAt])
  @@index([templateId, startAt])
  @@index([seriesId, startAt])
}

model ClassMessage {
  id             String   @id @default(cuid())
  occurrenceId   String
  instructorId   String
  subject        String
  body           String
  kind           String   @default("UPDATE")
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())

  occurrence ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  instructor User            @relation("ClassMessageInstructor", fields: [instructorId], references: [id], onDelete: Restrict)

  @@index([occurrenceId, createdAt])
  @@index([instructorId, createdAt])
}

model InAppNotification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model MemberConversation {
  id        String   @id @default(cuid())
  memberId  String   @unique
  subject   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member   User                        @relation("ConversationMember", fields: [memberId], references: [id], onDelete: Cascade)
  messages MemberConversationMessage[]

  @@index([updatedAt])
}

model MemberConversationMessage {
  id               String    @id @default(cuid())
  conversationId   String
  senderId         String
  subject          String?
  body             String
  memberReadAt     DateTime?
  managementReadAt DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  conversation MemberConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User               @relation("ConversationSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([conversationId, memberReadAt])
  @@index([conversationId, managementReadAt])
}

model Booking {
  id             String        @id @default(cuid())
  occurrenceId   String
  userId         String
  status         BookingStatus @default(CONFIRMED)
  source         String        @default("MEMBER")
  bookedAt       DateTime      @default(now())
  cancelledAt    DateTime?
  policySnapshot Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  occurrence ClassOccurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  attendance AttendanceRecord?
  paymentRecords PaymentRecord[]

  @@unique([occurrenceId, userId])
  @@index([userId, status, bookedAt])
  @@index([occurrenceId, status])
}

model BookingTransfer {
  id                    String         @id @default(cuid())
  bookingId             String
  memberId              String
  instructorId          String
  fromOccurrenceId      String
  toOccurrenceId        String?
  status                TransferStatus
  feeCents              Int            @default(0)
  stripePaymentIntentId String?        @unique
  reason                String?
  createdAt             DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@index([instructorId, createdAt])
  @@index([memberId, createdAt])
}

model WaitlistEntry {
  id           String         @id @default(cuid())
  occurrenceId String
  userId       String
  status       WaitlistStatus @default(WAITING)
  joinedAt     DateTime       @default(now())
  promotedAt   DateTime?
  leftAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  occurrence ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([occurrenceId, userId])
  @@index([occurrenceId, status, joinedAt])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  occurrenceId String
  bookingId    String?          @unique
  userId       String
  status       AttendanceStatus
  checkedInAt  DateTime?
  markedById   String?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  occurrence ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  booking    Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user       User            @relation("AttendanceMember", fields: [userId], references: [id], onDelete: Restrict)
  markedBy   User?           @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([occurrenceId, userId])
  @@index([occurrenceId, status])
}

model CreditAccount {
  id               String    @id @default(cuid())
  userId           String
  sourcePurchaseId String?   @unique
  label            String
  isUnlimited      Boolean   @default(false)
  validFrom        DateTime  @default(now())
  validUntil       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourcePurchase Purchase?           @relation(fields: [sourcePurchaseId], references: [id], onDelete: SetNull)
  entries        CreditLedgerEntry[]

  @@index([userId, validUntil])
}

model CreditLedgerEntry {
  id                    String          @id @default(cuid())
  creditAccountId       String
  bookingId             String?
  sourceStripeInvoiceId String?         @unique
  sourceReturnKey       String?         @unique
  type                  CreditEntryType
  quantity              Int
  reason                String?
  createdAt             DateTime        @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@index([creditAccountId, createdAt])
  @@index([bookingId])
}

model Product {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  description         String
  kind                ProductKind
  priceCents          Int
  billingInterval     BillingInterval @default(ONE_TIME)
  includedCredits     Int?
  isUnlimited         Boolean         @default(false)
  eligibleCategoryIds String[]
  trialDays           Int?
  cancellationPolicy  String?
  isPublic            Boolean         @default(true)
  isActive            Boolean         @default(true)
  availabilityStart   DateTime?
  availabilityEnd     DateTime?
  alwaysAvailable     Boolean         @default(true)
  displayOrder        Int             @default(0)
  customPlanType      String?
  stripePriceId       String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  purchases                  Purchase[]
  memberships                Membership[]
  requestedMembershipChanges MembershipChangeRequest[] @relation("RequestedMembershipProduct")

  @@index([isActive, isPublic, kind])
}

model Purchase {
  id                      String         @id @default(cuid())
  userId                  String
  productId               String
  status                  PurchaseStatus @default(PENDING)
  amountCents             Int
  currency                String         @default("usd")
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?        @unique
  paidAt                  DateTime?
  failedAt                DateTime?
  refundedAmountCents     Int            @default(0)
  discountCents           Int            @default(0)
  policyAcceptedAt        DateTime?
  policyAcceptance        Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  invoice            Invoice?
  refunds            Refund[]
  membership         Membership?
  discountRedemption DiscountRedemption?
  referralCommission ReferralCommission?
  paymentRecords     PaymentRecord[]
  creditAccount      CreditAccount?

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model Membership {
  id                   String           @id @default(cuid())
  userId               String
  productId            String
  purchaseId           String?          @unique
  status               MembershipStatus
  stripeSubscriptionId String?          @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime?
  activatedAt          DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user           User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  product        Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchase       Purchase?                 @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  paymentRecords PaymentRecord[]
  changeRequests MembershipChangeRequest[]
  freezes        MembershipFreeze[]

  @@index([userId, status, currentPeriodEnd])
}

model MembershipFreeze {
  id           String    @id @default(cuid())
  membershipId String
  createdById  String
  startAt      DateTime
  endAt        DateTime
  activatedAt  DateTime?
  resumedAt    DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("MembershipFreezeCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([membershipId, startAt, endAt])
  @@index([startAt, endAt, cancelledAt])
}

model MembershipChangeRequest {
  id                 String                        @id @default(cuid())
  userId             String
  membershipId       String
  type               MembershipChangeRequestType
  requestedProductId String?
  memberNote         String?
  status             MembershipChangeRequestStatus @default(PENDING)
  reviewedById       String?
  reviewNote         String?
  reviewedAt         DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  user             User       @relation("MembershipChangeMember", fields: [userId], references: [id], onDelete: Restrict)
  membership       Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  requestedProduct Product?   @relation("RequestedMembershipProduct", fields: [requestedProductId], references: [id], onDelete: SetNull)
  reviewedBy       User?      @relation("MembershipChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([membershipId, status])
}

model CommerceOrder {
  id                      String              @id @default(cuid())
  userId                  String?
  occurrenceId            String?
  kind                    CommerceOrderKind
  status                  CommerceOrderStatus @default(PENDING)
  amountCents             Int
  currency                String              @default("usd")
  customerName            String?
  customerEmail           String?
  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId   String?             @unique
  paidAt                  DateTime?
  failedAt                DateTime?
  refundedAmountCents     Int                 @default(0)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  occurrence     ClassOccurrence?    @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  items          CommerceOrderItem[]
  paymentRecords PaymentRecord[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([occurrenceId, status])
}

model CommerceOrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productReference String
  name             String
  description      String?
  variant          String?
  imageUrl         String?
  unitAmountCents  Int
  quantity         Int

  order CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PaymentRecord {
  id                      String              @id @default(cuid())
  userId                  String?
  purchaseId              String?
  membershipId            String?
  commerceOrderId         String?
  bookingId               String?
  kind                    PaymentRecordKind
  status                  PaymentRecordStatus
  amountCents             Int
  refundedAmountCents     Int                 @default(0)
  currency                String              @default("usd")
  customerName            String?
  customerEmail           String?
  stripeEventId           String              @unique
  stripeCustomerId        String?
  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId   String?             @unique
  stripeInvoiceId         String?             @unique
  stripeSubscriptionId    String?
  receiptUrl              String?
  occurredAt              DateTime            @default(now())
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  purchase      Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  membership    Membership?    @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  commerceOrder CommerceOrder? @relation(fields: [commerceOrderId], references: [id], onDelete: SetNull)
  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status, occurredAt])
  @@index([userId, occurredAt])
  @@index([bookingId, occurredAt])
  @@index([stripeSubscriptionId, occurredAt])
}

model Invoice {
  id              String   @id @default(cuid())
  purchaseId      String   @unique
  number          String   @unique
  amountCents     Int
  currency        String   @default("usd")
  receiptUrl      String?
  stripeInvoiceId String?  @unique
  issuedAt        DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
}

model Refund {
  id             String   @id @default(cuid())
  purchaseId     String
  amountCents    Int
  reason         String?
  stripeRefundId String?  @unique
  createdAt      DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([purchaseId, createdAt])
}

model StripeEvent {
  id          String    @id
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([type, createdAt])
}

model EmailMessage {
  id           String         @id @default(cuid())
  userId       String?
  direction    EmailDirection @default(OUTBOUND)
  from         String?
  to           String
  toList       String[]       @default([])
  cc           String[]       @default([])
  bcc          String[]       @default([])
  replyTo      String[]       @default([])
  subject      String
  template     String
  payload      Json
  textBody     String?
  htmlBody     String?
  headers      Json?
  messageId    String?
  threadId     String?
  status       EmailStatus    @default(QUEUED)
  scheduledFor DateTime       @default(now())
  sentAt       DateTime?
  receivedAt   DateTime?
  providerId   String?        @unique
  attempts     Int            @default(0)
  lastError    String?
  dedupeKey    String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  attachments EmailAttachment[]

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
  @@index([direction, createdAt])
  @@index([threadId, createdAt])
}

model EmailAttachment {
  id                 String   @id @default(cuid())
  emailMessageId     String
  resendAttachmentId String?
  filename           String
  contentType        String
  contentDisposition String?
  contentId          String?
  size               Int
  content            Bytes
  createdAt          DateTime @default(now())

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@unique([emailMessageId, resendAttachmentId])
  @@index([emailMessageId, createdAt])
}

model ResendWebhookEvent {
  id            String    @id
  type          String
  resendEmailId String?
  payload       Json
  processingAt  DateTime?
  processedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  @@index([type, createdAt])
  @@index([resendEmailId, createdAt])
}

model EmailTemplateReview {
  id              String   @id @default(cuid())
  template        String   @unique
  revision        String
  copyOverride    Json?
  approvedAt      DateTime @default(now())
  approvedById    String
  approvedByEmail String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([approvedAt])
}

model EmailCampaign {
  id             String         @id @default(cuid())
  createdById    String
  name           String
  subject        String
  previewText    String?
  body           String
  segment        String
  status         CampaignStatus @default(DRAFT)
  scheduledFor   DateTime?
  sentAt         DateTime?
  recipientCount Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdBy User @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, scheduledFor])
}

model Account {
  id                       String   @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  oauth_token_secret       String?
  oauth_token              String?
  refresh_token_expires_in Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model MemberProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  preferredName         String?
  phone                 String?
  photoUrl              String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  region                String?
  postalCode            String?
  country               String    @default("US")
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstructorProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  bio                     String?
  photoUrl                String?
  isActive                Boolean  @default(true)
  canEditOwnProfile       Boolean  @default(false)
  displayOrder            Int      @default(0)
  standardClassRateCents  Int?     @default(4000)
  specialtyEventRateCents Int?
  specialtyEventRateText  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstructorCredential {
  id               String           @id @default(cuid())
  instructorId     String
  type             CredentialType
  status           CredentialStatus @default(UNDER_REVIEW)
  storageKey       String
  originalFilename String
  contentType      String
  expiresAt        DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionNote    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  instructor User  @relation("CredentialInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("CredentialReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([instructorId, type, status])
  @@index([expiresAt, status])
}

model InstructorApplication {
  id           String                      @id @default(cuid())
  userId       String                      @unique
  status       InstructorApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  user       User  @relation("InstructorApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("InstructorReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model ReferralCode {
  id            String    @id @default(cuid())
  instructorId  String
  code          String    @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  deactivatedAt DateTime?

  instructor   User                  @relation("ReferralInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  attributions ReferralAttribution[]

  @@index([instructorId, isActive])
}

model ReferralAttribution {
  id             String   @id @default(cuid())
  referredUserId String   @unique
  referralCodeId String
  createdAt      DateTime @default(now())

  referredUser User         @relation("ReferredCustomer", fields: [referredUserId], references: [id], onDelete: Restrict)
  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)

  @@index([referralCodeId, createdAt])
}

model DiscountRedemption {
  id             String   @id @default(cuid())
  userId         String   @unique
  purchaseId     String   @unique
  referralCodeId String
  discountCents  Int
  createdAt      DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([referralCodeId, createdAt])
}

model ReferralCommission {
  id             String           @id @default(cuid())
  instructorId   String
  referredUserId String           @unique
  purchaseId     String           @unique
  amountCents    Int
  status         CommissionStatus @default(EARNED)
  earnedAt       DateTime         @default(now())
  reversedAt     DateTime?
  paidAt         DateTime?

  instructor   User     @relation("CommissionInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  referredUser User     @relation("CommissionCustomer", fields: [referredUserId], references: [id], onDelete: Restrict)
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([instructorId, status, earnedAt])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  transactionalEmail Boolean  @default(true)
  classReminders     Boolean  @default(true)
  marketingEmail     Boolean  @default(true)
  smsEnabled         Boolean  @default(false)
  timezone           String   @default("America/New_York")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AccountClaimToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model WaiverVersion {
  id           String   @id @default(cuid())
  version      Int      @unique
  title        String
  body         String
  effectiveAt  DateTime
  isActive     Boolean  @default(false)
  requiresSign Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  acceptances WaiverAcceptance[]

  @@index([isActive, effectiveAt])
}

model WaiverAcceptance {
  id              String   @id @default(cuid())
  waiverVersionId String
  userId          String
  acceptedAt      DateTime @default(now())
  signedDate      DateTime
  ipAddress       String?
  userAgent       String?
  mediaConsent    Boolean  @default(false)

  waiverVersion WaiverVersion @relation(fields: [waiverVersionId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([waiverVersionId, userId])
  @@index([userId, acceptedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model NewsletterLead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("website-footer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model SombleClientProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  sourceStatus   String
  lastWorkoutAt  DateTime?
  lastLoginAt    DateTime?
  sourceJoinedAt DateTime
  totalWorkouts  Int       @default(0)
  appDownloaded  Boolean   @default(false)
  birthday       DateTime?
  sourceFile     String
  importedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sourceStatus])
  @@index([sourceJoinedAt])
}

model SombleTransaction {
  id            String   @id @default(cuid())
  userId        String
  transferId    String   @unique
  paymentId     String   @unique
  transferredAt DateTime
  amountCents   Int
  contentType   String
  supporterName String
  sourceFile    String
  importedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([transferredAt])
  @@index([contentType, transferredAt])
  @@index([userId, transferredAt])
}
