generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  INSTRUCTOR
  MEMBER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum ClassIntensity {
  LOW
  MODERATE
  HIGH
  ALL_LEVELS
}

enum OccurrenceStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  LATE_CANCELLED
  ATTENDED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  PROMOTED
  LEFT
  EXPIRED
}

enum AttendanceStatus {
  CHECKED_IN
  ATTENDED
  NO_SHOW
  LATE_CANCELLED
}

enum CreditEntryType {
  GRANT
  RESERVE
  CONSUME
  RELEASE
  RESTORE
  EXPIRE
  ADJUSTMENT
}

enum ProductKind {
  INTRO_TRIAL
  MONTHLY_UNLIMITED
  LIMITED_MEMBERSHIP
  CLASS_PACK
  DROP_IN
  VIP
}

enum BillingInterval {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum MembershipStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum EmailStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum InstructorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CredentialType {
  INSURANCE
  CPR
}

enum CredentialStatus {
  UNDER_REVIEW
  VALID
  REJECTED
}

enum CommissionStatus {
  PENDING
  EARNED
  REVERSED
  PAID
}

enum TransferStatus {
  COMPLETED
  PAYMENT_FAILED
  BLOCKED
}

model User {
  id               String     @id @default(cuid())
  name             String?
  email            String     @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             Role       @default(MEMBER)
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  stripeCustomerId String?    @unique

  accounts               Account[]
  sessions               Session[]
  authenticators         Authenticator[]
  memberProfile          MemberProfile?
  instructorProfile      InstructorProfile?
  notificationPreference NotificationPreference?
  passwordResetTokens    PasswordResetToken[]
  waiverAcceptances      WaiverAcceptance[]
  auditLogs              AuditLog[]              @relation("AuditActor")
  classOccurrences       ClassOccurrence[]       @relation("OccurrenceInstructor")
  classSeries            ClassSeries[]           @relation("SeriesInstructor")
  bookings               Booking[]
  waitlistEntries        WaitlistEntry[]
  attendanceRecords      AttendanceRecord[]      @relation("AttendanceMember")
  attendanceMarked       AttendanceRecord[]      @relation("AttendanceMarker")
  creditAccounts         CreditAccount[]
  purchases              Purchase[]
  memberships            Membership[]
  emailMessages          EmailMessage[]
  campaignsCreated       EmailCampaign[]         @relation("CampaignCreator")
  instructorApplication  InstructorApplication?  @relation("InstructorApplicant")
  instructorReviews      InstructorApplication[] @relation("InstructorReviewer")
  referralCodes          ReferralCode[]          @relation("ReferralInstructor")
  instructorCredentials  InstructorCredential[]  @relation("CredentialInstructor")
  credentialReviews      InstructorCredential[]  @relation("CredentialReviewer")
  referralAttribution    ReferralAttribution?    @relation("ReferredCustomer")
  instructorCommissions  ReferralCommission[]    @relation("CommissionInstructor")
  referralCommission     ReferralCommission?     @relation("CommissionCustomer")
  inAppNotifications     InAppNotification[]
  classMessagesAuthored  ClassMessage[]          @relation("ClassMessageInstructor")
  sombleClientProfile    SombleClientProfile?
  sombleTransactions     SombleTransaction[]

  @@index([role, status])
  @@index([createdAt])
}

model ClassCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates ClassTemplate[]

  @@index([isActive, name])
}

model ClassTemplate {
  id                 String         @id @default(cuid())
  categoryId         String
  name               String
  slug               String         @unique
  description        String
  imageUrl           String?
  durationMinutes    Int
  intensity          ClassIntensity @default(ALL_LEVELS)
  defaultCapacity    Int
  dropInPriceCents   Int?
  tags               String[]
  equipment          String[]
  cancellationPolicy String?
  isActive           Boolean        @default(true)
  archivedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  category    ClassCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  series      ClassSeries[]
  occurrences ClassOccurrence[]

  @@index([categoryId, isActive])
  @@index([archivedAt])
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  timezone  String   @default("America/New_York")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms Room[]
}

model Room {
  id         String   @id @default(cuid())
  locationId String
  name       String
  capacity   Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location    Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  series      ClassSeries[]
  occurrences ClassOccurrence[]

  @@unique([locationId, name])
}

model ClassSeries {
  id             String    @id @default(cuid())
  templateId     String
  instructorId   String?
  roomId         String?
  timezone       String    @default("America/New_York")
  recurrenceRule String
  startsAt       DateTime
  endsAt         DateTime?
  capacity       Int?
  priceCents     Int?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  template    ClassTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  instructor  User?             @relation("SeriesInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  room        Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  occurrences ClassOccurrence[]

  @@index([templateId, isActive])
  @@index([instructorId, startsAt])
}

model ClassOccurrence {
  id                 String           @id @default(cuid())
  templateId         String
  seriesId           String?
  instructorId       String?
  roomId             String?
  startAt            DateTime
  endAt              DateTime
  timezone           String           @default("America/New_York")
  capacity           Int
  priceCents         Int?
  status             OccurrenceStatus @default(SCHEDULED)
  publicNotes        String?
  internalNotes      String?
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  template          ClassTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  series            ClassSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  instructor        User?              @relation("OccurrenceInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  room              Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bookings          Booking[]
  waitlistEntries   WaitlistEntry[]
  attendanceRecords AttendanceRecord[]
  classMessages     ClassMessage[]

  @@index([startAt, status])
  @@index([instructorId, startAt, endAt])
  @@index([roomId, startAt, endAt])
  @@index([templateId, startAt])
  @@index([seriesId, startAt])
}

model ClassMessage {
  id             String   @id @default(cuid())
  occurrenceId   String
  instructorId   String
  subject        String
  body           String
  kind           String   @default("UPDATE")
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())

  occurrence ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  instructor User            @relation("ClassMessageInstructor", fields: [instructorId], references: [id], onDelete: Restrict)

  @@index([occurrenceId, createdAt])
  @@index([instructorId, createdAt])
}

model InAppNotification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Booking {
  id             String        @id @default(cuid())
  occurrenceId   String
  userId         String
  status         BookingStatus @default(CONFIRMED)
  source         String        @default("MEMBER")
  bookedAt       DateTime      @default(now())
  cancelledAt    DateTime?
  policySnapshot Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  occurrence ClassOccurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  attendance AttendanceRecord?

  @@unique([occurrenceId, userId])
  @@index([userId, status, bookedAt])
  @@index([occurrenceId, status])
}

model BookingTransfer {
  id                    String         @id @default(cuid())
  bookingId             String
  memberId              String
  instructorId          String
  fromOccurrenceId      String
  toOccurrenceId        String?
  status                TransferStatus
  feeCents              Int            @default(0)
  stripePaymentIntentId String?        @unique
  reason                String?
  createdAt             DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@index([instructorId, createdAt])
  @@index([memberId, createdAt])
}

model WaitlistEntry {
  id           String         @id @default(cuid())
  occurrenceId String
  userId       String
  status       WaitlistStatus @default(WAITING)
  joinedAt     DateTime       @default(now())
  promotedAt   DateTime?
  leftAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  occurrence ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([occurrenceId, userId])
  @@index([occurrenceId, status, joinedAt])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  occurrenceId String
  bookingId    String?          @unique
  userId       String
  status       AttendanceStatus
  checkedInAt  DateTime?
  markedById   String?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  occurrence ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  booking    Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user       User            @relation("AttendanceMember", fields: [userId], references: [id], onDelete: Restrict)
  markedBy   User?           @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([occurrenceId, userId])
  @@index([occurrenceId, status])
}

model CreditAccount {
  id          String    @id @default(cuid())
  userId      String
  label       String
  isUnlimited Boolean   @default(false)
  validFrom   DateTime  @default(now())
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries CreditLedgerEntry[]

  @@index([userId, validUntil])
}

model CreditLedgerEntry {
  id              String          @id @default(cuid())
  creditAccountId String
  bookingId       String?
  type            CreditEntryType
  quantity        Int
  reason          String?
  createdAt       DateTime        @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@index([creditAccountId, createdAt])
  @@index([bookingId])
}

model Product {
  id                  String          @id @default(cuid())
  name                String
  slug                String          @unique
  description         String
  kind                ProductKind
  priceCents          Int
  billingInterval     BillingInterval @default(ONE_TIME)
  includedCredits     Int?
  isUnlimited         Boolean         @default(false)
  eligibleCategoryIds String[]
  trialDays           Int?
  cancellationPolicy  String?
  isPublic            Boolean         @default(true)
  isActive            Boolean         @default(true)
  stripePriceId       String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  purchases   Purchase[]
  memberships Membership[]

  @@index([isActive, isPublic, kind])
}

model Purchase {
  id                      String         @id @default(cuid())
  userId                  String
  productId               String
  status                  PurchaseStatus @default(PENDING)
  amountCents             Int
  currency                String         @default("usd")
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?        @unique
  paidAt                  DateTime?
  failedAt                DateTime?
  refundedAmountCents     Int            @default(0)
  discountCents           Int            @default(0)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  invoice            Invoice?
  refunds            Refund[]
  membership         Membership?
  discountRedemption DiscountRedemption?
  referralCommission ReferralCommission?

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model Membership {
  id                   String           @id @default(cuid())
  userId               String
  productId            String
  purchaseId           String?          @unique
  status               MembershipStatus
  stripeSubscriptionId String?          @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([userId, status, currentPeriodEnd])
}

model Invoice {
  id              String   @id @default(cuid())
  purchaseId      String   @unique
  number          String   @unique
  amountCents     Int
  currency        String   @default("usd")
  receiptUrl      String?
  stripeInvoiceId String?  @unique
  issuedAt        DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
}

model Refund {
  id             String   @id @default(cuid())
  purchaseId     String
  amountCents    Int
  reason         String?
  stripeRefundId String?  @unique
  createdAt      DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([purchaseId, createdAt])
}

model StripeEvent {
  id          String    @id
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([type, createdAt])
}

model EmailMessage {
  id           String      @id @default(cuid())
  userId       String?
  to           String
  subject      String
  template     String
  payload      Json
  status       EmailStatus @default(QUEUED)
  scheduledFor DateTime    @default(now())
  sentAt       DateTime?
  providerId   String?
  attempts     Int         @default(0)
  lastError    String?
  dedupeKey    String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
}

model EmailCampaign {
  id             String         @id @default(cuid())
  createdById    String
  name           String
  subject        String
  previewText    String?
  body           String
  segment        String
  status         CampaignStatus @default(DRAFT)
  scheduledFor   DateTime?
  sentAt         DateTime?
  recipientCount Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdBy User @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, scheduledFor])
}

model Account {
  id                       String   @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  oauth_token_secret       String?
  oauth_token              String?
  refresh_token_expires_in Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model MemberProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  preferredName         String?
  phone                 String?
  photoUrl              String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  region                String?
  postalCode            String?
  country               String    @default("US")
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstructorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  bio               String?
  photoUrl          String?
  isActive          Boolean  @default(true)
  canEditOwnProfile Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstructorCredential {
  id               String           @id @default(cuid())
  instructorId     String
  type             CredentialType
  status           CredentialStatus @default(UNDER_REVIEW)
  storageKey       String
  originalFilename String
  contentType      String
  expiresAt        DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionNote    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  instructor User  @relation("CredentialInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("CredentialReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([instructorId, type, status])
  @@index([expiresAt, status])
}

model InstructorApplication {
  id           String                      @id @default(cuid())
  userId       String                      @unique
  status       InstructorApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  user       User  @relation("InstructorApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("InstructorReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model ReferralCode {
  id            String    @id @default(cuid())
  instructorId  String
  code          String    @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  deactivatedAt DateTime?

  instructor   User                  @relation("ReferralInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  attributions ReferralAttribution[]

  @@index([instructorId, isActive])
}

model ReferralAttribution {
  id             String   @id @default(cuid())
  referredUserId String   @unique
  referralCodeId String
  createdAt      DateTime @default(now())

  referredUser User         @relation("ReferredCustomer", fields: [referredUserId], references: [id], onDelete: Restrict)
  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)

  @@index([referralCodeId, createdAt])
}

model DiscountRedemption {
  id             String   @id @default(cuid())
  userId         String   @unique
  purchaseId     String   @unique
  referralCodeId String
  discountCents  Int
  createdAt      DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([referralCodeId, createdAt])
}

model ReferralCommission {
  id             String           @id @default(cuid())
  instructorId   String
  referredUserId String           @unique
  purchaseId     String           @unique
  amountCents    Int
  status         CommissionStatus @default(EARNED)
  earnedAt       DateTime         @default(now())
  reversedAt     DateTime?
  paidAt         DateTime?

  instructor   User     @relation("CommissionInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  referredUser User     @relation("CommissionCustomer", fields: [referredUserId], references: [id], onDelete: Restrict)
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([instructorId, status, earnedAt])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  transactionalEmail Boolean  @default(true)
  classReminders     Boolean  @default(true)
  marketingEmail     Boolean  @default(true)
  smsEnabled         Boolean  @default(false)
  timezone           String   @default("America/New_York")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model WaiverVersion {
  id           String   @id @default(cuid())
  version      Int      @unique
  title        String
  body         String
  effectiveAt  DateTime
  isActive     Boolean  @default(false)
  requiresSign Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  acceptances WaiverAcceptance[]

  @@index([isActive, effectiveAt])
}

model WaiverAcceptance {
  id              String   @id @default(cuid())
  waiverVersionId String
  userId          String
  acceptedAt      DateTime @default(now())
  signedDate      DateTime
  ipAddress       String?
  userAgent       String?
  mediaConsent    Boolean  @default(false)

  waiverVersion WaiverVersion @relation(fields: [waiverVersionId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([waiverVersionId, userId])
  @@index([userId, acceptedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model NewsletterLead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("website-footer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model SombleClientProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  sourceStatus   String
  lastWorkoutAt  DateTime?
  lastLoginAt    DateTime?
  sourceJoinedAt DateTime
  totalWorkouts  Int       @default(0)
  appDownloaded  Boolean   @default(false)
  birthday       DateTime?
  sourceFile     String
  importedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sourceStatus])
  @@index([sourceJoinedAt])
}

model SombleTransaction {
  id            String   @id @default(cuid())
  userId        String
  transferId    String   @unique
  paymentId     String   @unique
  transferredAt DateTime
  amountCents   Int
  contentType   String
  supporterName String
  sourceFile    String
  importedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([transferredAt])
  @@index([contentType, transferredAt])
  @@index([userId, transferredAt])
}
